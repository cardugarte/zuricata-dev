---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import zuricataImg from '@/assets/zuricata.png';
import { Globe, Mail, X, Instagram } from 'lucide-astro';

const icons = {
  globe: Globe,
  mail: Mail,
  x: X,
  instagram: Instagram,
} as const;

const socialLinks: {
  label: string;
  href: string;
  icon: keyof typeof icons;
}[] = [
  {
    label: 'travelsats.ar',
    href: 'https://travelsats.ar',
    icon: 'globe',
  },
  {
    label: 'carlos@travelsats.ar',
    href: 'mailto:carlos@travelsats.ar',
    icon: 'mail',
  },
  {
    label: '@LaZuricata',
    href: 'https://x.com/LaZuricata',
    icon: 'x',
  },
  {
    label: '@Travelsats',
    href: 'https://x.com/LaZuricata',
    icon: 'x',
  },
  {
    label: '@cardugarte',
    href: 'https://instagram.com/cardugarte',
    icon: 'instagram',
  },
];
---

<BaseLayout
  title="Links"
  description="Find La Zuricata across the web."
>
  <section class="py-12 md:py-16">
    <div class="section-container">
      <div class="mx-auto flex w-full max-w-md flex-col items-center">
        <div
          class="mb-5 rounded-full bg-gradient-to-br from-accent-bright via-accent to-accent-dim p-[3px]"
        >
          <Image
            src={zuricataImg}
            alt="La Zuricata"
            width={128}
            height={128}
            class="block rounded-full bg-surface-base"
          />
        </div>

        <h1 class="mb-8 text-2xl">La Zuricata</h1>

        <ul class="flex w-full flex-col gap-3">
          {
            socialLinks.map((link) => {
              const Icon = icons[link.icon];
              const isExternal = link.href.startsWith('http');
              return (
                <li>
                  <a
                    href={link.href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="card flex w-full items-center gap-3 py-4 no-underline"
                  >
                    <Icon size={20} class="shrink-0 text-accent" />
                    <span class="font-mono text-sm text-text-primary sm:text-base">
                      {link.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

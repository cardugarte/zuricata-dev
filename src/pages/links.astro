---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import zuricataImg from '@/assets/zuricata.png';
import { Globe, Mail, Instagram } from 'lucide-astro';
import NostrIcon from '@components/icons/NostrIcon.astro';

const lucideIcons = {
  globe: Globe,
  mail: Mail,
  instagram: Instagram,
} as const;

const socialLinks: {
  label: string;
  href: string;
  icon: 'globe' | 'mail' | 'x' | 'instagram' | 'nostr';
}[] = [
  {
    label: 'travelsats.ar',
    href: 'https://travelsats.ar',
    icon: 'globe',
  },
  {
    label: 'carlos@travelsats.ar',
    href: 'mailto:carlos@travelsats.ar',
    icon: 'mail',
  },
  {
    label: '@LaZuricata',
    href: 'https://x.com/LaZuricata',
    icon: 'x',
  },
  {
    label: '@Travelsats',
    href: 'https://x.com/Travelsats',
    icon: 'x',
  },
  {
    label: '@cardugarte',
    href: 'https://instagram.com/cardugarte',
    icon: 'instagram',
  },
  {
    label: 'Travelsats',
    href: 'https://njump.me/npub1n6rgfxfq8jukt872wzll0uh503c7ju8m400perdnwp9d9d2lvcks5cax8u',
    icon: 'nostr',
  },
  {
    label: 'Zuricata',
    href: 'https://njump.me/npub12ehepccx7dudmcdlegw9k6acjdyj4xyz5wrxsy3snac4fjlsrldq2tq6hm',
    icon: 'nostr',
  },
];

const total = String(socialLinks.length).padStart(2, '0');
---

<BaseLayout
  title="Links"
  description="Find La Zuricata across the web."
>
  <section class="py-16 md:py-24">
    <div class="section-container">
      <div class="mx-auto flex w-full max-w-md flex-col items-center">
        <div class="mb-8 w-full">
          <SectionHeader kicker="links" counter={`01 / ${total}`} />
        </div>

        <div class="mb-6 overflow-hidden rounded-full border border-border">
          <Image
            src={zuricataImg}
            alt="La Zuricata"
            width={256}
            height={256}
            class="block size-32 rounded-full bg-surface-base"
          />
        </div>

        <h1 class="mb-10 text-3xl md:text-4xl">La Zuricata</h1>

        <ul class="flex w-full flex-col gap-3">
          {
            socialLinks.map((link, index) => {
              const LucideIcon =
                link.icon in lucideIcons
                  ? lucideIcons[link.icon as keyof typeof lucideIcons]
                  : null;
              const isExternal = link.href.startsWith('http');
              const inverted = index === 0;
              return (
                <li>
                  <a
                    href={link.href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class:list={[
                      'card flex w-full items-center gap-3 py-5 no-underline',
                      inverted && 'card-inverted',
                    ]}
                  >
                    {link.icon === 'x' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="currentColor"
                        class:list={[
                          'shrink-0',
                          inverted ? 'text-surface-base' : 'text-text-label',
                        ]}
                        aria-hidden="true"
                      >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                    )}
                    {link.icon === 'nostr' && (
                      <NostrIcon
                        size={20}
                        class:list={[
                          'shrink-0',
                          inverted ? 'text-surface-base' : 'text-text-label',
                        ]}
                      />
                    )}
                    {LucideIcon && (
                      <LucideIcon
                        size={20}
                        class:list={[
                          'shrink-0',
                          inverted ? 'text-surface-base' : 'text-text-label',
                        ]}
                      />
                    )}
                    <span
                      class:list={[
                        'font-mono text-sm sm:text-base',
                        inverted ? 'text-surface-base' : 'text-text-primary',
                      ]}
                    >
                      {link.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import zuricataImg from '@/assets/zuricata.png';
import { Globe, Mail, Instagram } from 'lucide-astro';

const lucideIcons = {
  globe: Globe,
  mail: Mail,
  instagram: Instagram,
} as const;

const socialLinks: {
  label: string;
  href: string;
  icon: 'globe' | 'mail' | 'x' | 'instagram' | 'nostr';
}[] = [
  {
    label: 'travelsats.ar',
    href: 'https://travelsats.ar',
    icon: 'globe',
  },
  {
    label: 'carlos@travelsats.ar',
    href: 'mailto:carlos@travelsats.ar',
    icon: 'mail',
  },
  {
    label: '@LaZuricata',
    href: 'https://x.com/LaZuricata',
    icon: 'x',
  },
  {
    label: '@Travelsats',
    href: 'https://x.com/Travelsats',
    icon: 'x',
  },
  {
    label: '@cardugarte',
    href: 'https://instagram.com/cardugarte',
    icon: 'instagram',
  },
  {
    label: 'Travelsats',
    href: 'https://njump.me/npub1n6rgfxfq8jukt872wzll0uh503c7ju8m400perdnwp9d9d2lvcks5cax8u',
    icon: 'nostr',
  },
  {
    label: 'Zuricata',
    href: 'https://njump.me/npub12ehepccx7dudmcdlegw9k6acjdyj4xyz5wrxsy3snac4fjlsrldq2tq6hm',
    icon: 'nostr',
  },
];
---

<BaseLayout
  title="Links"
  description="Find La Zuricata across the web."
>
  <section class="py-12 md:py-16">
    <div class="section-container">
      <div class="mx-auto flex w-full max-w-md flex-col items-center">
        <div
          class="mb-5 rounded-full bg-gradient-to-br from-accent-bright via-accent to-accent-dim p-[3px]"
        >
          <Image
            src={zuricataImg}
            alt="La Zuricata"
            width={256}
            height={256}
            class="block size-32 rounded-full bg-surface-base"
          />
        </div>

        <h1 class="mb-8 text-2xl">La Zuricata</h1>

        <ul class="flex w-full flex-col gap-3">
          {
            socialLinks.map((link) => {
              const LucideIcon =
                link.icon in lucideIcons
                  ? lucideIcons[link.icon as keyof typeof lucideIcons]
                  : null;
              const isExternal = link.href.startsWith('http');
              return (
                <li>
                  <a
                    href={link.href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="card flex w-full items-center gap-3 py-4 no-underline"
                  >
                    {link.icon === 'x' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="currentColor"
                        class="shrink-0 text-accent"
                        aria-hidden="true"
                      >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                    )}
                    {link.icon === 'nostr' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="currentColor"
                        class="shrink-0 text-accent"
                        aria-hidden="true"
                      >
                        <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm3.836 14.264c-.384.426-.901.672-1.477.736-.16.016-.32.024-.48.024-.544 0-1.072-.144-1.536-.416a5.07 5.07 0 0 1-.696-.48c-.384-.304-.768-.608-1.2-.832-.368-.192-.752-.288-1.152-.288-.064 0-.128.008-.192.016a1.75 1.75 0 0 0-1.072.544c-.288.304-.448.704-.448 1.12 0 .064.008.128.016.192.08.608.416 1.136.928 1.456.352.224.752.336 1.168.336.096 0 .192-.008.288-.024.464-.064.88-.288 1.184-.632l.736.656c-.48.528-1.12.864-1.824.96-.144.016-.288.024-.432.024-.608 0-1.2-.16-1.712-.48-.768-.48-1.28-1.264-1.392-2.176a2.69 2.69 0 0 1-.016-.288c0-.624.24-1.216.672-1.664.464-.496 1.104-.8 1.792-.864.096-.008.192-.016.288-.016.576 0 1.136.144 1.648.416.336.176.648.4.944.624.352.272.704.544 1.104.752.288.144.592.224.912.224.048 0 .096 0 .144-.008.4-.048.768-.224 1.04-.512.256-.272.4-.624.4-.992 0-.048 0-.096-.008-.144-.064-.528-.352-.992-.8-1.28a1.98 1.98 0 0 0-1.024-.288c-.08 0-.16.008-.24.016-.384.048-.736.24-.992.528l-.736-.656c.416-.464.976-.768 1.6-.848.128-.016.256-.024.384-.024.528 0 1.04.144 1.504.416.672.432 1.104 1.12 1.2 1.904.016.08.016.16.016.24 0 .56-.208 1.088-.592 1.504z" />
                      </svg>
                    )}
                    {LucideIcon && (
                      <LucideIcon size={20} class="shrink-0 text-accent" />
                    )}
                    <span class="font-mono text-sm text-text-primary sm:text-base">
                      {link.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

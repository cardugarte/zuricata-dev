---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import zuricataImg from '@/assets/zuricata.png';
import { Globe, Mail, Instagram } from 'lucide-astro';

const lucideIcons = {
  globe: Globe,
  mail: Mail,
  instagram: Instagram,
} as const;

const socialLinks: {
  label: string;
  href: string;
  icon: 'globe' | 'mail' | 'x' | 'instagram';
}[] = [
  {
    label: 'travelsats.ar',
    href: 'https://travelsats.ar',
    icon: 'globe',
  },
  {
    label: 'carlos@travelsats.ar',
    href: 'mailto:carlos@travelsats.ar',
    icon: 'mail',
  },
  {
    label: '@LaZuricata',
    href: 'https://x.com/LaZuricata',
    icon: 'x',
  },
  {
    label: '@Travelsats',
    href: 'https://x.com/Travelsats',
    icon: 'x',
  },
  {
    label: '@cardugarte',
    href: 'https://instagram.com/cardugarte',
    icon: 'instagram',
  },
];
---

<BaseLayout
  title="Links"
  description="Find La Zuricata across the web."
>
  <section class="py-12 md:py-16">
    <div class="section-container">
      <div class="mx-auto flex w-full max-w-md flex-col items-center">
        <div
          class="mb-5 rounded-full bg-gradient-to-br from-accent-bright via-accent to-accent-dim p-[3px]"
        >
          <Image
            src={zuricataImg}
            alt="La Zuricata"
            width={256}
            height={256}
            class="block size-32 rounded-full bg-surface-base"
          />
        </div>

        <h1 class="mb-8 text-2xl">La Zuricata</h1>

        <ul class="flex w-full flex-col gap-3">
          {
            socialLinks.map((link) => {
              const LucideIcon =
                link.icon in lucideIcons
                  ? lucideIcons[link.icon as keyof typeof lucideIcons]
                  : null;
              const isExternal = link.href.startsWith('http');
              return (
                <li>
                  <a
                    href={link.href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="card flex w-full items-center gap-3 py-4 no-underline"
                  >
                    {link.icon === 'x' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="currentColor"
                        class="shrink-0 text-accent"
                        aria-hidden="true"
                      >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                    )}
                    {LucideIcon && (
                      <LucideIcon size={20} class="shrink-0 text-accent" />
                    )}
                    <span class="font-mono text-sm text-text-primary sm:text-base">
                      {link.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

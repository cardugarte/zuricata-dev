---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '@components/ui/FormattedDate.astro';
import TagList from '@components/ui/TagList.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import NostrIcon from '@components/icons/NostrIcon.astro';
import { bodyLeadsWithCover } from '@lib/articleCover';

interface Props {
  title: string;
  summary: string;
  cover: string;
  publishedAt: Date;
  tags: string[];
  xUrl: string;
  nostrUrl?: string;
  body: string;
}

const { title, summary, cover, publishedAt, tags, xUrl, nostrUrl, body } = Astro.props;
const showCover = !bodyLeadsWithCover(body, cover);
---

<BaseLayout
  title={title}
  description={summary}
  lang="es"
  image={cover}
  ogType="article"
  publishedTime={publishedAt}
>
  <article class="article-page py-12 md:py-20">
    <div class="section-container min-w-0">
      <header class="mb-10">
        <SectionHeader kicker="article" />
        <h1 class="text-[1.75rem] leading-[1.12] md:text-5xl">{title}</h1>
        <div class="sunset-rule mt-5"></div>
        <p class="mt-6 text-lg leading-relaxed text-text-bajada">{summary}</p>
        <div class="mt-5">
          <FormattedDate
            date={publishedAt}
            locale="es-AR"
            timeZone="America/Argentina/Mendoza"
          />
        </div>
        {
          tags.length > 0 && (
            <div class="mt-4">
              <TagList tags={tags} />
            </div>
          )
        }
        {
          showCover && (
            <img
              src={cover}
              alt=""
              class="mt-8 h-auto w-full border border-border"
              style="border-radius: var(--radius-card)"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )
        }
      </header>

      <div class="article-prose prose-content">
        <slot />
      </div>

      <footer class="mt-14 border-t border-border pt-8">
        <p class="section-heading mb-4">publicado en</p>
        <div class="flex flex-col items-start gap-1">
          <a
            class="article-outlink"
            href={xUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Leer en X
          </a>
          {
            nostrUrl && (
              <a
                class="article-outlink"
                href={nostrUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <NostrIcon size={18} />
                Ver en Nostr
              </a>
            )
          }
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

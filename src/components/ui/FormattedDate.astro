---
interface Props {
  date: Date;
  locale?: string;
  timeZone?: string;
}

const { date, locale = 'en-US', timeZone } = Astro.props;

const formatted = date.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  ...(timeZone ? { timeZone } : {}),
});
---

<time datetime={date.toISOString()} class="font-mono text-xs text-text-label">
  {formatted}
</time>

---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  inverted?: boolean;
}

const { id, title, description, pubDate, tags, inverted = false } = Astro.props;
---

<a
  href={`/blog/${id}`}
  class:list={['card block no-underline', inverted && 'card-inverted']}
>
  <article>
    <div class="font-mono text-xs text-text-label">
      <FormattedDate date={pubDate} />
    </div>
    <h3 class="card-title mt-3 text-xl leading-tight">{title}</h3>
    <p class="card-body mt-3 text-sm">{description}</p>
    {tags.length > 0 && (
      <div class="mt-4">
        <TagList tags={tags} />
      </div>
    )}
  </article>
</a>

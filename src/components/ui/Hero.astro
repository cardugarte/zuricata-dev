---
import { Image } from 'astro:assets';
import zuricataImg from '@/assets/zuricata.png';
import SectionHeader from './SectionHeader.astro';
---

<section class="py-20 md:py-28">
  <div class="section-container">
    <SectionHeader kicker="whoami" counter="01 / 04" />

    <div
      class="flex flex-col-reverse items-center gap-12 md:flex-row md:items-center md:gap-16"
    >
      <div class="flex-1">
        <h1 class="mb-5 text-5xl leading-[0.95] md:text-6xl">
          zuricata<span class="text-text-label">.dev</span>
        </h1>
        <div class="gold-rule mb-8"></div>

        <p class="mb-10 max-w-lg text-text-body">
          I build products with AI at the core — from tourism platforms on Lightning
          to legal AI agents. I automate everything else. If it can be built, I ship it.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/blog" class="btn-inverted">Blog</a>
          <a href="/projects" class="btn">Projects</a>
        </div>
      </div>

      <div class="shrink-0 overflow-hidden rounded-full border border-border">
        <Image
          src={zuricataImg}
          alt="zuricata"
          width={280}
          height={280}
          class="size-[220px] rounded-full md:size-[260px]"
        />
      </div>
    </div>
  </div>
</section>

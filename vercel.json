{
  "redirects": [
    {
      "source": "/blog",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/blog/:slug/",
      "destination": "/articles",
      "permanent": true
    }
  ]
}
